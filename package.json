{
  "name": "@unrealworks/roform",
  "version": "0.1.0",
  "description": "Parse Roblox files into render-agnostic glTF",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Unreal-Works/roform.git"
  },
  "bin": {
    "roform": "bin/roform.js"
  },
  "files": [
    "bin",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@unrealworks/roform-darwin-arm64": "0.1.0",
    "@unrealworks/roform-darwin-x64": "0.1.0",
    "@unrealworks/roform-linux-arm64": "0.1.0",
    "@unrealworks/roform-linux-x64": "0.1.0",
    "@unrealworks/roform-win32-arm64": "0.1.0",
    "@unrealworks/roform-win32-x64": "0.1.0"
  },
  "scripts": {
    "build": "cargo build --release",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "set-version": "bun scripts/set-version.js",
    "test": "cargo test"
  }
}
